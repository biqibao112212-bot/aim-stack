{
  "simulator": {
    "repository_relative_to_workspace": "repos/daedalus-simulator",
    "release_relative_to_workspace": "releases/daedalus-simulator/1.3.1/linux-x86_64",
    "version": "1.3.1",
    "source_commit": "d7637d00f69f0b6b01814c4fef6087baa92b0607",
    "sdk_version": "1.3.1",
    "shm_version": 7,
    "sdk_abi_revision": 2,
    "metadata_size": 76992,
    "image": {
      "format": "rgba32",
      "width": 1440,
      "height": 1080
    },
    "physics_hz": 250,
    "image_transport": "tcp",
    "tcp_image_protocol": 1,
    "tcp_image_port": 5602,
    "udp_command_port": 5601,
    "scene_control_protocol": 2,
    "scene_control_port": 5603,
    "consumer_guide": {
      "path": "SIMULATOR_CONSUMER_GUIDE.md",
      "version": 1
    },
    "release_documents": {
      "sdk_usage": "docs/README.md",
      "interface": "docs/SDK_API_REFERENCE_ZH.md",
      "scenario_control": "docs/SCENARIO_CONTROL.md",
      "performance": "docs/SIMULATOR_PERFORMANCE.md",
      "offline_exact_corners": "docs/OFFLINE_EXACT_CORNER_EXPORT_ZH.md",
      "offline_full_frame_capture": "schemas/offline-frame-capture-v1.schema.json"
    },
    "native_operator_maps": [
      {"id": "normal_map", "sdk_scene": "armor", "shortcut": "F7"},
      {"id": "shooting_range", "sdk_scene": "shooting_range", "shortcut": "F8"},
      {"id": "energy_mechanism", "sdk_scene": "energy", "shortcut": "F9"}
    ],
    "runtime_profiles": {
      "default": "high_performance",
      "high_performance": {"visible": false, "preview_max_hz": 0},
      "visible_acceptance": {"visible": true, "preview_max_hz": 60}
    },
    "offline_exports": {
      "exact_corner_labels": {
        "schema_version": "daedalus.offline-exact-corners/1",
        "schema_file": "schemas/offline-exact-corners-v1.schema.json",
        "environment_variable": "DAEDALUS_CORNER_LABELS_JSONL",
        "default_enabled": false,
        "requires_tcp_client": true,
        "commit_point": "after_complete_tcp_frame_write",
        "online_target_truth_enabled": false,
        "future_truth_included": false
      },
      "full_frame_capture": {
        "schema_version": "daedalus.offline-frame-capture/1",
        "schema_file": "schemas/offline-frame-capture-v1.schema.json",
        "collector_option": "--save-rgba-frames",
        "default_enabled": false,
        "requires_until_eof": true,
        "image_format": "rgba32-raw",
        "online_target_truth_enabled": false,
        "future_truth_included": false
      }
    }
  }
}
