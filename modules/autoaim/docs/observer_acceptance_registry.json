  "state_machine": [
    {
      "state": "NO_DATA",
      "meaning": "no valid candidate has been observed",
      "qualified_dynamic_output": false
    },
    {
      "state": "ACQUIRING",
      "meaning": "valid events exist but the temporal qualification gate is not met",
      "qualified_dynamic_output": false
    },
    {
      "state": "OBSERVED_ANONYMOUS",
      "meaning": "stream, candidate, time, local-continuity and applicability gates pass",
      "qualified_dynamic_output": true,
      "physical_identity_resolved": false
    },
    {
      "state": "AMBIGUOUS_SET",
      "meaning": "greater-than-four candidates, close assignments, crossing or unresolved set change",
      "qualified_dynamic_output": false,
      "preserve_complete_candidate_set": true
    },
    {
      "state": "STALE",
      "meaning": "latest valid event age exceeds 50 ms",
      "qualified_dynamic_output": false
    },
    {
      "state": "REACQUIRING",
      "meaning": "a new event follows stale, ambiguity or reset; old ephemeral identity is not reused",
      "qualified_dynamic_output": false
    },
    {
      "state": "INVALID_STREAM",
      "meaning": "schema, epoch, key, timestamp or sink failure",
      "qualified_dynamic_output": false,
      "clear_state": true
    }
  ],
