{
  "schema_version": "aim-stack.corner-repair-pose-equivalent-plan/1",
  "purpose": "Train a detector-only corner repairer whose offline target is calibrated to the unchanged nominal 135x55-mm production IPPE template.",
  "simulator_release": "Daedalus Simulator 1.3.1 linux-x86_64",
  "inputs": {
    "runtime": "rgb-128x64 1.5x detector quad plus raw-detector-only 15d geometry",
    "offline_supervision_only": [
      "exact_corners_px",
      "measured_width_m",
      "measured_height_m"
    ],
    "forbidden_runtime_inputs": [
      "truth",
      "motion",
      "identity",
      "range",
      "future"
    ]
  },
  "frozen_design": {
    "architecture": "v2-context-spatial",
    "target_space": "context-normalized-residual",
    "target_definition": "nominal-pnp-pose-equivalent",
    "application_policy": {
      "minimum_detector_score": null,
      "minimum_predicted_correction_rms_px": 4.0,
      "rejected_behavior": "return raw detector corners unchanged"
    },
    "seeds": [1701, 2701, 3701],
    "seed_selection": "Among validation-gate-passing seeds, maximize aggregate pixel RMS improvement; break ties by the least per-mode regression, then the lower seed.",
    "production_pnp": "unchanged nominal-small-armor SOLVEPNP_IPPE"
  },
  "validation_gate": {
    "minimum_aggregate_rms_improvement_fraction": 0.05,
    "maximum_per_mode_rms_regression_fraction": 0.02,
    "sealed_test_accessed": false
  },
  "test_policy": {
    "previously_opened_test_forbidden_for_selection": "/home/potato/Projects/仿真/runtime/corner-repair-final-test-v1-20260819",
    "collect_new_session_disjoint_test_only_after_validation_pass": true,
    "minimum_aggregate_rms_improvement_fraction": 0.05,
    "maximum_per_mode_rms_regression_fraction": 0.02,
    "no_model_or_policy_update_after_test": true
  },
  "downstream_policy": {
    "run_same_anchor raw-versus-repaired through unchanged IPPE and frozen 400ms LOS expert only after the new sealed corner test passes": true,
    "production_cpp_integration_requires_both_corner_and_downstream_gates": true
  }
}
